	function check-prerequisites {
		
		Start-Job -Name checkPrerequesitesGraph -ScriptBlock {
			$user = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name.Split("\")[-1]
			$graph = Get-InstalledModule -Name Microsoft.Graph.Authentication | Select-Object Name -ErrorAction Ignore -Wait
			if($graph){
				$graph | Export-Csv "C:\Users\$user\AppData\Local\Temp\autopilotV2.log" -NoTypeInformation -Force
			}
			else {
				$prerequesites = [PSCustomObject]@{
					name = "none"
				} | Export-Csv "C:\Users\$user\AppData\Local\Temp\autopilotV2.log" -NoTypeInformation -Force
			}
		}
		
		do {
			[System.Windows.Forms.Application]::DoEvents()
			$jobGraph = Get-Job checkPrerequesitesGraph -ErrorAction Ignore
		
			if($jobgraph.State -eq "Completed"){	
				if (Test-Path $logPath) {
					$status = 0
				}
			}	
		}while ($status -ne 0)
	
		Remove-Job -Name checkPrerequesitesGraph
		
		$logContent = Import-Csv $logPath
		return $logContent
	}
	
	function install-nuget {
		Start-Job -Name InstallNuGet -ScriptBlock {
			Install-PackageProvider -Name Nuget -Force
		}
		
		$status = 0
		do {
			[System.Windows.Forms.Application]::DoEvents()
			$jobStatus = get-job InstallNuGet
			
			if ($jobStatus.State -like "Completed") {
				get-job InstallNuGet | remove-job
				$status = 1
			}
			if ($jobStatus.State -like "Failed") {
				get-job InstallNuGet | remove-job
				break
			}
		}
		while ($status -eq 0)
	}
	
	function install-graphmodule{
		Start-Job -Name InstallModule -ScriptBlock {
			Install-Module -Name Microsoft.Graph.Authentication -Force
		}
		
		$status = 0
		do {
			[System.Windows.Forms.Application]::DoEvents()
			$jobStatus = get-job InstallModule
			
			if ($jobStatus.State -like "Completed") {
				get-job InstallModule | remove-job
				$status = 1
			}
			if ($jobStatus.State -like "Failed") {
				get-job InstallModule | remove-job
				break
			}
		}while ($status -eq 0)
		return $status
	}
	
#endregion Source: managment-module.ps1

