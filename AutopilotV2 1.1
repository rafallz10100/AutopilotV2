	function check-internet{
		$testAddress = "8.8.8.8"
		
		$pingResult = Test-Connection -ComputerName $testAddress -Count 1 -Quiet -ErrorAction Ignore
		add-toLog -content "Checking internet access..." -color Default
		if ($pingResult) {
			add-toLog -content "Access to the Internet: YES" -color Success
		}
		else {
			add-toLog -content "Access to the Internet: NO" -color Warning
			add-toLog -content "Connect to the internet to use the application" -color Warning
			$buttonImportSerialNumber.Enabled = $false
		}
	}
	
	function check-ifadmin{
		$isAdmin = [bool](([System.Security.Principal.WindowsIdentity]::GetCurrent()).groups -match "S-1-5-32-544")
		add-toLog -content "Checking if the application was run as administrator..." -color Default
		if ($isAdmin -eq 1) {
			add-toLog -content "Is Administrator - YES" -color Success
		}
		else{
			add-toLog -content "Please start app as an administrator" -color Warning
			$buttonImportSerialNumber.Enabled = $false
		}
	}
	
	function get-OSBuild {
		
		[CmdletBinding()]
		Param
		(
			[Parameter(Mandatory = $false,
					   ValueFromPipelineByPropertyName = $true,
					   ValueFromPipeline = $true
					   )]
			[string[]]$ComputerName = $env:COMPUTERNAME
		)
		
		Begin {
			$Table = New-Object System.Data.DataTable
			$Table.Columns.AddRange(@("ComputerName", "Windows Edition", "Version", "OS Build"))
		}
		Process {
			Foreach ($Computer in $ComputerName) {
				$Code = {
					$ProductName = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' -Name ProductName).ProductName
					Try {
						$Version = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' -Name ReleaseID -ErrorAction Stop).ReleaseID
					}
					Catch {
						$Version = "N/A"
					}
					$CurrentBuild = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' -Name CurrentBuild).CurrentBuild
					$UBR = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' -Name UBR).UBR
					$OSVersion = $CurrentBuild + "." + $UBR
					
					$TempTable = New-Object System.Data.DataTable
					$TempTable.Columns.AddRange(@("ComputerName", "Windows Edition", "Version", "OS Build"))
					[void]$TempTable.Rows.Add($env:COMPUTERNAME, $ProductName, $Version, $OSVersion)
					
					Return $TempTable
				}
				
				If ($Computer -eq $env:COMPUTERNAME) {
					$Result = Invoke-Command -ScriptBlock $Code
					[void]$Table.Rows.Add($Result.Computername, $Result.'Windows Edition', $Result.Version, $Result.'OS Build')
				}
				Else {
					Try {
						$Result = Invoke-Command -ComputerName $Computer -ScriptBlock $Code -ErrorAction Stop
						[void]$Table.Rows.Add($Result.Computername, $Result.'Windows Edition', $Result.Version, $Result.'OS Build')
					}
					Catch {
						$_
					}
				}
			}
		}
		End {
			Return $Table
		}
	}
	
	function get-computerData{
		$win32_ComputerSystem = Get-WmiObject -Class Win32_ComputerSystem | Select-Object Manufacturer, Model
		$Win32_SN           = (Get-WmiObject -Class Win32_BIOS).SerialNumber
		
		
		$computerData = [PSCustomObject]@{
			Manufacturer = $win32_ComputerSystem.Manufacturer
			Model        = $win32_ComputerSystem.Model
			SerialNumber = $Win32_SN
		}
		
		return $computerData
	}
	
	function add-toLog{
		param (
			[parameter(Mandatory = $true)]
			[string]$content,
			
			[parameter(Mandatory = $true)]
			[ValidateSet("Default", "Warning", "Success")]
			[string]$color
		)
		
		if($color -eq "Default"){
			$richtextbox.SelectionColor  = [System.Drawing.Color]::White
		}
		if ($color -eq "Warning") {
			$richtextbox.SelectionColor  = [System.Drawing.Color]::Yellow
		}
		if ($color -eq "Success") {
			$richtextbox.SelectionColor  = [System.Drawing.Color]::LawnGreen
		}
		
		$richtextbox.AppendText("$content`n")
		
	}
	
	$formAutopilotV2_Load={
		check-internet
		check-ifadmin
		
		$data = get-computerData
		$labelManufacturerValue.Text  = $data.Manufacturer
		$labelModelValue.Text         = $data.Model
		$labelSerialNumberValue.Text  = $data.SerialNumber
		
		$OSBuild = get-OSBuild
		$version = [System.Version] $OSBuild.'OS Build'
		
		$labelOSVersionValue.Text = $version
		
		if ($version.Major -gt 22621 -or ($version.Major -eq 22621 -and $version.Minor -ge 3374)) {
			$labelOSVersionValue.Text += " - OK"
			$labelOSVersionValue.ForeColor = [System.Drawing.Color]::Green
		}
		elseif ($version.Major -lt 22000) {
			$labelOSVersionValue.Text += " - need upgrade system to Windows 11"
			$labelOSVersionValue.ForeColor = [System.Drawing.Color]::Red
		}
		else {
			$labelOSVersionValue.Text += " - need update system"
			$labelOSVersionValue.ForeColor = [System.Drawing.Color]::Red
		}
	}
	
	$buttonExportToCsvFile_Click={
		add-toLog -content "Preparing data..." -color Default
		$user = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name.Split("\")[-1]
		$logPath = "C:\Users\$user\AppData\Local\Temp\AutopilotV2.csv"
		#$data = ForEach-Object {"""" + $labelManufacturerValue.Text + """,","""" + $labelModelValue.Text + """,","""" + $labelSerialNumberValue.Text + """"}
		
		$data = '"{0}","{1}","{2}"' -f $labelManufacturerValue.Text, $labelModelValue.Text, $labelSerialNumberValue.Text
		$data | Out-File $logPath
		Start-Process notepad.exe -ArgumentList $logPath
		add-toLog -content "Data prepared - displayed in the notepad" -color Success
	}
	
	$buttonImportSerialNumber_Click={
		$buttonImportSerialNumber.Enabled = $false
		add-toLog -content "Checking prerequisites..." -color Default
		add-toLog -content "Checking if Microsoft.Graph.Authentication module is installed..." -color Default
		$prerequisites = check-prerequisites
		
		$policy = Get-ExecutionPolicy
		Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Force | Out-Null
	
		if(!($prerequisites.name -contains "Microsoft.Graph.Authentication")){
			add-toLog -content "Microsoft.Graph.Authentication module is not installed" -color Warning
			add-toLog -content "Nuget package is being installed..." -color Default
			$installNuget = install-nuget
			if($installNuget){
				add-toLog -content "Nuget package has been installed" -color Success
				add-toLog -content "Microsoft.Graph.Authentication package is being installed..." -color Default
				$installGraph = install-graphmodule
				
				if($installGraph){
					add-toLog -content "Microsoft.Graph.Authentication has been installed" -color Success
					add-toLog -content "Attempting to connect to graph..." -color Success
					
					try {
						Import-Module -Name Microsoft.Graph.Authentication
						$connetion = Connect-MgGraph -Scopes "DeviceManagementServiceConfig.ReadWrite.All" -ContextScope Process -NoWelcome -ErrorAction Stop
						
						add-toLog -content "Connected to graph" -color Success
						add-toLog -content "Checking if the serial number has been imported before..." -color Default
						
						$SN = $labelSerialNumberValue.text -replace "-", ""
						$importedSerial = check-SN -SerialNumber $SN
						
						if ($importedSerial -eq 1) {
							add-toLog -content "The serial number has been imported previously" -color Default
						}
						else {
							add-toLog -content "The serial number is being imported into Device Identifiers in Intune..." -color Default
							$import = import-SN -manufacturer $labelManufacturerValue.Text -model $labelModelValue.Text -SerialNumber $labelSerialNumberValue.text
							if ($import -eq 1) {
								add-toLog -content "The serial number has been imported" -color Success
							}
							else {
								add-toLog -content $import -color Warning
							}
							Disconnect-mgGraph | Out-Null
						}
					}
					catch {
						add-toLog -content $_ -color Warning
					}
					Set-ExecutionPolicy -ExecutionPolicy $policy -Force
				}
				else {
					add-toLog -content "There was a problem with the installation, please try again..." -color Warning
				}
			}
			else {
				add-toLog -content "There was a problem with the installation, please try again..." -color Warning
			}
		}
		else {
			add-toLog -content "Microsoft.Graph.Authentication module is installed" -color Success
			add-toLog -content "Attempting to connect to graph" -color Success
			
			try {
				Import-Module -Name Microsoft.Graph.Authentication
				$connetion = Connect-MgGraph -Scopes "DeviceManagementServiceConfig.ReadWrite.All" -ContextScope process -NoWelcome -ErrorAction Stop
				
				add-toLog -content "Connected to graph" -color Success
				add-toLog -content "Checking if the serial number has been imported before..." -color Default
				
				$SN = $labelSerialNumberValue.text -replace "-", ""
				$importedSerial = check-SN -SerialNumber $SN
				
				if ($importedSerial -eq 1) {
					add-toLog -content "The serial number has been imported previously" -color Default
				}
				else {
					add-toLog -content "The serial number is being imported into Device Identifiers in Intune..." -color Default
					$import = import-SN -manufacturer $labelManufacturerValue.Text -model $labelModelValue.Text -SerialNumber $labelSerialNumberValue.text
					if ($import -eq 1) {
						add-toLog -content "The serial number has been imported" -color Success
					}
					else {
						add-toLog -content $import -color Warning
					}
					Disconnect-mgGraph | Out-Null
				}		
			}
			catch {
				add-toLog -content $_ -color Warning
			}
			Set-ExecutionPolicy -ExecutionPolicy $policy -Force
		}
		
		$buttonImportSerialNumber.Enabled = $true
	}
	
