	function check-SN {
		param (
			[parameter(Mandatory = $true)]
			[string]$SerialNumber
		)
		
		$URL = "https://graph.microsoft.com/beta/deviceManagement/importedDeviceIdentities/"
		
		$graphRequest = Invoke-MgGraphRequest -Uri $URL -Method Get
		
		$graphRequest = $graphRequest.Values.Values
		$splitedRequest = $graphRequest -split ","
		
		if($splitedRequest -contains $SerialNumber){
			$status = 1	
		} 
		else{
			$status = 0
		}
		return $status
	}
	
	function import-SN{
		param (
			[string]$manufacturer,
			[string]$model,
			[string]$SerialNumber
		)
		$URL = "https://graph.microsoft.com/beta/deviceManagement/importedDeviceIdentities/importDeviceIdentityList"
		
		$body = @{
			overwriteImportedDeviceIdentities = $false
			importedDeviceIdentities		  = @(
				@{
					importedDeviceIdentityType = "manufacturerModelSerial"
					importedDeviceIdentifier   = "$manufacturer,$model,$serialNumber"
				}
			)
		}
		
		try{
			Invoke-MgGraphRequest -Uri $URL -Method POST -Body $body
			return 1
		}
		catch{
			return "There was a problem importing. Please check your permissions."
		}
			
	}
#endregion Source: managment-SN.ps1

